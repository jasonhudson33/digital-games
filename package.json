{
  "name": "digital-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "test": "npm run test:root && npm run test:monopoly",
    "test:root": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:monopoly": "node monopoly/scripts/game-rules.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run validate && npm run build",
    "start": "next start",
    "lint": "npm run typecheck",
    "validate": "node scripts/validate-frontend.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.28.0",
    "next": "^15.5.22",
    "postcss": "^8.5.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
